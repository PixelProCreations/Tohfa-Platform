<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug network security configuration.
  Allows cleartext traffic to localhost, 10.0.2.2 (Android emulator host loopback),
  and local dev IPs during development.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
      <certificates src="user" />
    </trust-anchors>
  </base-config>
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="true">localhost</domain>
    <domain includeSubdomains="true">10.0.2.2</domain>
    <domain includeSubdomains="true">10.210.219.253</domain>
  </domain-config>
</network-security-config>
