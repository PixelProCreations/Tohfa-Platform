{
  "name": "@tohfa/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "TOHFA mobile. One React Native 0.88 codebase, three shipped flavors (farmer, customer, admin) — see docs/react-native-guidelines.md and this app's CLAUDE.md.",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "maestro test .maestro/customer-golden-thread.yaml .maestro/farmer-golden-thread.yaml"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.2.2",
    "@react-native-documents/picker": "12.0.3",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "@rnmapbox/maps": "10.3.16",
    "@tanstack/react-query": "^5.28.0",
    "@tohfa/design-tokens": "workspace:*",
    "@tohfa/mobile-ui": "workspace:*",
    "@tohfa/shared-types": "workspace:*",
    "lottie-react-native": "^7.5.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-calendars": "^1.1314.0",
    "react-native-fbsdk-next": "^13.4.3",
    "react-native-keychain": "^10.0.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-svg": "15.16.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/gradle-plugin": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "react-native-dotenv": "^4.1.1",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "19.3.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
