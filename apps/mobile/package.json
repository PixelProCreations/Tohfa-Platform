{
  "name": "@tohfa/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "TOHFA mobile. One React Native 0.74 codebase, three shipped flavors (farmer, customer, admin) — see docs/react-native-guidelines.md and this app's CLAUDE.md.",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "maestro test .maestro/customer-golden-thread.yaml .maestro/farmer-golden-thread.yaml"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.0",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-native-community/datetimepicker": "^8.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@rnmapbox/maps": "10.2.9",
    "@tanstack/react-query": "^5.28.0",
    "@tohfa/design-tokens": "workspace:*",
    "@tohfa/mobile-ui": "workspace:*",
    "@tohfa/shared-types": "workspace:*",
    "lottie-react-native": "^6.7.2",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-calendars": "^1.1314.0",
    "react-native-document-picker": "^9.3.1",
    "react-native-fbsdk-next": "^13.4.3",
    "react-native-keychain": "^10.0.0",
    "react-native-svg": "15.2.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.74.87",
    "@react-native/metro-config": "0.74.87",
    "@types/react": "^18.2.79",
    "@types/react-test-renderer": "^18.0.7",
    "react-native-dotenv": "^4.1.1",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
