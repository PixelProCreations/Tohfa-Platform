{
  /* React Native uses Metro + Babel, so tsc is a typechecker only (--noEmit).
     Strictness deliberately matches tsconfig.base.json — copied from
     farmer-mobile/customer-mobile's identical tsconfig, see
     docs/react-native-guidelines.md. */
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    "typeRoots": [
      "./node_modules/@types",
      "../../node_modules/@types"
    ],
    "types": ["react"],
    "baseUrl": ".",
    "paths": {
      "@tohfa/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@tohfa/design-tokens": ["../../packages/design-tokens/src/index.ts"],
      "@tohfa/mobile-ui": ["../../packages/mobile-ui/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "index.js"
  ],
  "exclude": ["node_modules", "android", "ios"]
}
