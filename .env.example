# ---------------------------------------------------------------------------
# TOHFA platform environment template.
# Copy to `.env` (never commit `.env`). Every var below is read and validated
# by apps/api/src/config.ts at boot — a missing required var fails fast.
# ---------------------------------------------------------------------------

# Runtime mode. One of: development | test | production
NODE_ENV=development

# Port the API HTTP server binds to.
PORT=3000

# PostgreSQL 16 (+PostGIS) connection string used by pg.Pool and the migrator.
DATABASE_URL=postgres://tohfa:tohfa@localhost:5432/tohfa

# Redis connection string. Used for OTP storage, cart locks and BullMQ queues.
REDIS_URL=redis://localhost:6379

# HS256 secret for signing access + refresh JWTs. Min 32 chars. Rotate per env.
JWT_SECRET=change-me-in-every-environment-min-32-chars

# Access token lifetime (vercel/ms format, e.g. 5m, 1h). Kept short because
# logout/session-revocation only invalidates the refresh token immediately --
# an already-issued access token stays valid until it expires (see
# apps/api/src/auth/requireAuth.ts). The client refreshes transparently on a
# 401, so a short TTL here doesn't mean the user re-enters credentials often.
JWT_ACCESS_TTL=5m

# Refresh token lifetime. Mobile apps rely on this for silent re-auth.
JWT_REFRESH_TTL=30d

# Azure Blob Storage connection string for produce photos, certificates, invoices.
AZURE_STORAGE_CONNECTION_STRING=

# Azure Blob container name that receives uploaded media.
AZURE_BLOB_CONTAINER=tohfa-media

# Razorpay public key id (customer checkout).
RAZORPAY_KEY_ID=

# Razorpay secret key. Server-side only, never shipped to a client.
RAZORPAY_KEY_SECRET=

# Shared secret used to verify the X-Razorpay-Signature webhook header.
RAZORPAY_WEBHOOK_SECRET=

# RazorpayX account number used as the source for farmer payouts.
RAZORPAYX_ACCOUNT=

# Which payment adapter to load. `mock` keeps dev/CI offline and deterministic.
# One of: mock | razorpay
PAYMENT_PROVIDER=mock

# Which SMS/OTP adapter to load. `mock` writes the OTP to the log instead.
# One of: mock | msg91 | twilio
SMS_PROVIDER=mock

# MSG91 auth key (only read when SMS_PROVIDER=msg91).
MSG91_AUTH_KEY=

# Twilio credentials (only read when SMS_PROVIDER=twilio).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# OpenWeatherMap API key. The farm-weather endpoint always calls the real
# OpenWeatherMap API — there is no mock mode. Leave blank in an environment
# that doesn't need weather data; requests will fail with a clear 502
# (WEATHER_PROVIDER_ERROR) instead of the app refusing to boot.
# Get a free key at https://openweathermap.org/api — never commit a real one.
OPENWEATHERMAP_API_KEY=

# Firebase Cloud Messaging server key for push notifications.
FCM_SERVER_KEY=

# Sentry DSN. Leave empty to disable error reporting.
SENTRY_DSN=

# OAuth social login (BR-39). OAuth is an alternate login method / registration
# prefill for an already mobile-verified account — never a way to create or
# activate an account without mobile+OTP. Placeholder values below; real
# Google/Facebook developer console credentials do not exist yet.
# Google OAuth 2.0 client id (verified as the ID token's audience).
GOOGLE_OAUTH_CLIENT_ID=changeme.apps.googleusercontent.com
# Facebook App ID.
FACEBOOK_APP_ID=changeme
# Facebook App Secret. Server-side only, never shipped to a client.
FACEBOOK_APP_SECRET=changeme

# Number of digits in a generated OTP.
OTP_LENGTH=6

# How long an issued OTP stays valid, in seconds.
OTP_TTL_SECONDS=300

# Max verification attempts per OTP before it is burned.
OTP_MAX_ATTEMPTS=3

# Cooldown, in seconds, before a new OTP may be requested for the same target.
OTP_RESEND_SECONDS=60

# Comma-separated list of browser origins allowed by CORS (admin web, etc.).
CORS_ORIGINS=http://localhost:4200

# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
